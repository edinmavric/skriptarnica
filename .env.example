# Copy to `.env` and fill in. Never commit real values.
# Validated by src/env.ts — the app will not start if a required variable is missing or invalid.

# --- Core ---------------------------------------------------------------
# Postgres connection URL. Local: the docker-compose database below.
# Preview/production: the Neon connection string (pooled), with `?sslmode=require`.
DATABASE_URL=postgres://skripta:skripta@localhost:5433/skripta

# Public base URL of the app, without a trailing slash. Used for canonical URLs, emails and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Sentry (optional; error reporting is disabled when the DSN is empty) ---
# Server-side DSN (Sentry project → Settings → Client Keys).
SENTRY_DSN=
# Browser DSN; usually the same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: enables source map upload. Create an org auth token with `project:releases` scope.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- CI only ------------------------------------------------------------
# Set to `true` to skip validation (lint/typecheck jobs only; never in a running app).
# SKIP_ENV_VALIDATION=
