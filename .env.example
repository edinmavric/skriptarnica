# Copy to `.env` and fill in. Never commit real values.
# Validated by src/env.ts — the app will not start if a required variable is missing or invalid.
# Local values below match docker-compose.yml (developer machines only).

# --- Core ---------------------------------------------------------------
# development | test | preview | production. Independent of NODE_ENV.
# /dev/* routes and the mock payment provider are disabled when APP_ENV=production.
APP_ENV=development
# Postgres connection URL. Local: docker-compose. Preview/production: Neon pooled URL with ?sslmode=require.
DATABASE_URL=postgres://skripta:skripta@localhost:5433/skripta
# Public base URL of the app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Auth (Better Auth) ---------------------------------------------------
# Session/token signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth (optional; the Google button is hidden when unset). Google Cloud Console → OAuth client.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile (bot protection on sign-up). For local dev use Cloudflare's documented
# always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Check new passwords against Have I Been Pwned (k-anonymity API, no key). Set false only offline.
HIBP_ENABLED=true

# --- Redis (Upstash REST) -------------------------------------------------
# Local: the serverless-redis-http container (token is set in docker-compose.yml).
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=
# Multiplies every rate limit. Leave at 1; Playwright's server sets it for E2E runs, which sign in
# many times from one IP. Refused in production and preview.
RATE_LIMIT_MULTIPLIER=1

# --- Object storage (Cloudflare R2 via S3 API) ----------------------------
# R2: https://<account-id>.r2.cloudflarestorage.com, region "auto". Local: SeaweedFS container.
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket: original PDFs and watermarked copies. Never public.
S3_PRIVATE_BUCKET=skripta-private
# Public bucket: preview page images and avatars, served via CDN.
S3_PUBLIC_BUCKET=skripta-public
# true for SeaweedFS/MinIO; false for R2.
S3_FORCE_PATH_STYLE=true
# Public URL of the public bucket (R2 custom domain/CDN). Local: path-style bucket URL.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=http://localhost:8333/skripta-public
# Origin the browser uploads to with presigned PUT (allowed in CSP connect-src).
NEXT_PUBLIC_STORAGE_UPLOAD_ORIGIN=http://localhost:8333

# --- Background jobs (Inngest) ---------------------------------------------
# Local: INNGEST_DEV=1 with the inngest container (dashboard at http://localhost:8288).
INNGEST_DEV=1
# Required for preview/production (Inngest Cloud → Manage → Keys).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Email ----------------------------------------------------------------
# Resend API key. Required for preview/production. When empty (local), emails go to the
# dev outbox: http://localhost:3000/dev/outbox
RESEND_API_KEY=
# Sender, e.g. "Skriptarnica <noreply@yourdomain.rs>" (domain verified in Resend).
EMAIL_FROM=Skriptarnica <noreply@localhost>
# Operational alerts (failed jobs, webhook errors, review queue).
ALERT_EMAIL=

# --- Payments ---------------------------------------------------------------
# Only "mock" exists until the production processor adapter is implemented (Phase 11).
PAYMENT_PROVIDER=mock
# HMAC secret for mock provider webhooks. Generate: openssl rand -hex 32
MOCK_PAYMENT_WEBHOOK_SECRET=

# --- Security ---------------------------------------------------------------
# AES-256-GCM keys for seller payout details, versioned for rotation (see docs/RUNBOOK.md).
# Format: v1:<base64 32 bytes>[,v2:<base64 32 bytes>]. Generate a key: openssl rand -base64 32
PAYOUT_ENCRYPTION_KEYS=
# Version used for new encryptions; older versions stay for decryption until re-encrypted.
PAYOUT_ENCRYPTION_ACTIVE_VERSION=v1
# Salt for hashing IP addresses before storing them. Generate: openssl rand -hex 32
IP_HASH_SALT=

# --- Analytics (loaded only after cookie consent) -----------------------------
# Production/preview: the PostHog project API key (public by design) and the EU host.
# Local dev and CI: any non-empty placeholder key plus the dev sink below, so the consent flow
# runs end to end without sending data anywhere (the sink 404s when APP_ENV=production).
NEXT_PUBLIC_POSTHOG_KEY=
# EU host: https://eu.i.posthog.com   Local: http://localhost:3000/api/dev/analytics
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry (optional; disabled when the DSN is empty) --------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: source map upload. Org auth token with project:releases scope.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Tooling only -----------------------------------------------------------
# SKIP_ENV_VALIDATION=true   # unit tests only; never in a running app
