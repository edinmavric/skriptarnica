{
  "name": "skripta-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next/dev && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/db-reset.ts",
    "test:e2e": "playwright test",
    "i18n:sync": "node scripts/sync-messages.mjs",
    "i18n:check": "node scripts/sync-messages.mjs --check",
    "db:seed": "tsx src/server/db/seed/index.ts",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "payout-keys:rotate": "tsx scripts/rotate-payout-keys.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "js:budget": "node scripts/js-budget.mjs",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@hookform/resolvers": "5.9.2",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "@sentry/nextjs": "11.9.0",
    "@types/hast": "3.0.5",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hast-util-to-jsx-runtime": "2.3.6",
    "inngest": "4.26.0",
    "mupdf": "1.28.1",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "posthog-js": "1.438.7",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "rehype-external-links": "3.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "resend": "6.34.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "undici": "7.30.1",
    "unified": "11.0.5",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "hast-util-to-html": "9.0.5",
    "intl-messageformat": "12.1.4",
    "jsdom": "30.1.3",
    "lighthouse": "13.5.0",
    "otpauth": "9.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
